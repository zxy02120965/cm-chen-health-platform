# MySQL 8 connection used by the backend.
# Copy this file to .env and fill in the password locally.
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_database_user
MYSQL_PASSWORD=your_database_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# 使用本地 Docker MySQL 时填写 mysql；生产环境主机请仅在未跟踪的 .env 中配置。
DB_HOST=your-rds-host.example.com
DB_PORT=3306

# Optional local API settings.
CORS_ORIGINS=http://localhost:5173
