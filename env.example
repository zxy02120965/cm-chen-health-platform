# 复制为项目根目录的 .env 后再填写；本文件不含真实凭据。
# 默认使用本机 SQLite，数据库文件会在 backend 目录下按需创建。
DATABASE_URL=sqlite:///./cm_chen_dev.db

# 使用 MySQL/RDS 时，注释上面的 DATABASE_URL，并填写以下配置。
# DB_HOST=your-rds-host.example.com
# DB_PORT=3306
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=your_database_password

# 兼容 Docker/旧部署命名；不要与 DB_* 填写相互冲突的值。
# MYSQL_DATABASE=your_database_name
# MYSQL_USER=your_database_user
# MYSQL_PASSWORD=your_database_password

# 后端允许访问的前端来源。
CORS_ORIGINS=http://localhost:5173

# 前端直接访问后端的地址；留空时使用 Vite 的 /api 代理。
# VITE_API_BASE_URL=
